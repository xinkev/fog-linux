FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    debootstrap e2fsprogs rsync cpio gzip xz-utils curl \
    android-sdk-libsparse-utils util-linux ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
