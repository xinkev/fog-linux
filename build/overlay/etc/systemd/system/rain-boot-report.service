# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Rain boot report on VT2 (USB/gadget diagnostics)
After=usb-adb-gadget.service adbd.service multi-user.target
Wants=usb-adb-gadget.service adbd.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/boot-report.sh
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
