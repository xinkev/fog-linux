# Native arm64 build env for upstream v7.3.0 (kernel v7.3 + Ubuntu 26.04 rootfs).
# Host is Apple Silicon, so no cross compiler / qemu is needed.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    device-tree-compiler \
    bc bison flex \
    libssl-dev libelf-dev \
    cpio gzip xz-utils zstd \
    python3 python3-pip \
    git curl ca-certificates \
    rsync e2fsprogs util-linux kmod \
    android-sdk-libsparse-utils \
    wireless-regdb \
    sudo \
    file zip unzip \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
